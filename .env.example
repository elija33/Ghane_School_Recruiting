# ================================================================
# Ghana Teacher Recruiting Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# ---------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------
POSTGRES_DB=ghteacher
POSTGRES_USER=ghteacher
POSTGRES_PASSWORD=your_strong_database_password_here

# ---------------------------------------------------------------
# JWT Authentication
# Generate with: openssl rand -base64 64
# Must be Base64-encoded, at least 256 bits
# ---------------------------------------------------------------
JWT_SECRET=your_base64_encoded_jwt_secret_here_minimum_64_chars

# ---------------------------------------------------------------
# Cloudinary (https://cloudinary.com)
# Find in: Cloudinary Dashboard > Settings > API Keys
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------------------------------------------------------------
# Paystack (https://paystack.com)
# Find in: Paystack Dashboard > Settings > API Keys & Webhooks
# Use TEST key for development, LIVE key for production
# ---------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# ---------------------------------------------------------------
# Prembly API (https://prembly.com)
# Used for: Ghana criminal background checks
# Find in: Prembly Dashboard > API Keys
# ---------------------------------------------------------------
PREMBLY_API_KEY=your_prembly_api_key_here

# ---------------------------------------------------------------
# ETX.NG API (https://etx.ng)
# Used for: Education credential verification
# Find in: ETX.NG Dashboard > API Settings
# ---------------------------------------------------------------
ETXNG_API_KEY=your_etxng_api_key_here

# ---------------------------------------------------------------
# CORS Allowed Origins
# Add your frontend app origins (Expo dev server, web, etc.)
# ---------------------------------------------------------------
CORS_ALLOWED_ORIGIN_1=http://localhost:3000
CORS_ALLOWED_ORIGIN_2=http://localhost:8081
CORS_ALLOWED_ORIGIN_3=exp://localhost:8081
